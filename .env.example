# Runtime
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/harness.db
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
API_AUTH_TOKEN=
PUBLIC_DEMO_MODE=false
ALLOW_TOOL_PLAYGROUND=false
PUBLIC_DEMO_RATE_LIMIT_PER_MINUTE=20
PUBLIC_DEMO_MAX_STEPS=8
PUBLIC_DEMO_TOKEN_BUDGET=8000
PUBLIC_DEMO_EVAL_LIMIT=30

# Provider: fake | deepseek | openai-compatible
DEFAULT_PROVIDER=fake
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# Memory and context
TOKEN_BUDGET=32000
SUMMARY_TRIGGER_TOKENS=24000
LONG_TERM_MEMORY_ENABLED=true

# Tool policy
WORKSPACE_ROOT=./workspace
TOOL_DEFAULT_TIMEOUT_SECONDS=30
TOOL_MAX_RETRIES=2
ALLOW_LOCAL_CODE_EXECUTION=false
GITHUB_TOKEN=
DATABASE_READONLY_URL=

# Docker sandbox
SANDBOX_BACKEND=docker
SANDBOX_IMAGE=python:3.12-alpine
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_TIMEOUT_SECONDS=20
SANDBOX_NETWORK_DISABLED=true
# On Linux, set this to the host group that owns /var/run/docker.sock.
DOCKER_GID=0

# MCP: JSON list. Set enabled=true to load the bundled stdio server.
MCP_SERVERS_JSON=[]
